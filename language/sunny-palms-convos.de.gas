[t:0x0407,n:text]
{
    // welcome1
	[0x0000]
	{
		from = "How nice to meet you, Visitor! Welcome to the Island of Sunny Palms!";
		to = "Wie schön dich kennenzulernen, Besucher! Willkommen auf der Insel Sunny Palms!";
	}
	[0x0000]
	{
		from = "Is it your first time visiting Sunny Palms? You should go for a walk around the island to see all the places and meet everyone! Most people will be here in the village, or down at the South Beach.";
		to = "Ist dies dein erster Besuch auf Sunny Palms? Du solltest um die Insel herumspazieren und dir alles anschauen und die Leute treffen! Die meisten Leute sind hier im Dorf, oder unten am Südstrand.";
	}
	[0x0000]
	{
		from = "This island is a haven of peace. It's the perfect place to escape from the world.";
		to = "Diese Insel ist ein friedlicher Ort. Perfekt um der Welt zu entkommen.";
	}

    // welcome2
	[0x0000]
	{
		from = "Welcome to our peaceful little island. Make yourself at home!";
		to = "Willkommen auf unserer friedlichen kleinen Insel. Fühl dich wie zu Hause!";
	}
	[0x0000]
	{
		from = "I've lived on this island my whole life. There's no place I'd rather be.";
		to = "Ich lebe schon mein ganzes Leben lang auf dieser Insel. Es gibt keinen Ort an den ich lieber will.";
	}

    // west_cliff
	[0x0000]
	{
		from = "Nice view, huh? You should come here at sunset. The view is breathtaking!";
		to = "Hübsche Aussicht, was? Du solltest zum Sonnenuntergang hierherkommen. Der Anblick verschlägt einem den Atem!";
	}
	[0x0000]
	{
		from = "The West Beach and the East Beach are not accessible. They are left alone for the birds and animals of the island. You can visit the North Beach and the South Beach, though. On the South Beach, there's the Three Saints Bar; the North Beach is more quiet.";
		to = "Der Weststrand und der Oststrand sind nicht zugänglich. Sie werden den Vögeln und Tieren der Insel überlassen. Du kannst jedoch den Nordstrand und den Südstrand besuchen. Am Südstrand liegt die Drei-Heiligen-Bar; der Nordstrand ist ruhiger.";
	}

	// bug_season
	[0x0000]
	{
		from = "About once a year, all the fireflies on this island hatch into big, biting bugs. It's called Bug Season. We go out hunting, it's great fun - you should join us if you're still around!";
		to = "Etwa einmal im Jahr verwandeln sich die ganzen Glühwürmer dieser Insel in große, beißwütige Käfer. Es nennt sich Käferzeit. Wir gehen dann jagen, das ist ein Riesenspaß - du solltest mal mitkommen wenn du dann noch da bist!";
	}

	// flowers
	[0x0000]
	{
		from = "The flowers bloom in a special way around here. Some say they have magical properties.";
		to = "Die Blumen hier blühen ganz besonders. Manche sagen, sie haben magische Eigenschaften.";
	}

	// pool1
	[0x0000]
	{
		from = "The water's perfect today! I could float here all afternoon.";
		to = "Das Wasser heute ist perfekt! Ich könnte den ganzen Nachmittag hier herumdümpeln.";
	}
	[0x0000]
	{
		from = "This pool is a hidden gem! The water's always so clear and inviting.";
		to = "Dieser Pool ist ein verstecktes Juwel! Das Wasser ist immer so klar und einladend.";
	}
	[0x0000]
	{
		from = "The sun's out, the water's warm - what more could you ask for?";
		to = "Die Sonne ist draußen, das Wasser ist warm - was will man mehr?";
	}

	// pool2
	[0x0000]
	{
		from = "I'm working on my tan. Just a few more minutes and I'll be golden!";
		to = "Ich arbeite an meinem Tan. Noch ein paar Minuten und ich bin golden!";
	}
	[0x0000]
	{
		from = "I remember learning to swim right here in this pool. So many good memories.";
		to = "Ich weiß noch wie ich hier in diesem Pool Schwimmen gelernt habe. So viele schöne Erinnerungen.";
	}
	[0x0000]
	{
		from = "Such a beautiful day for a swim, don't you think?";
		to = "So ein schöner Tag um zu schwimmen, findest du nicht?";
	}

	// pool_hammock
	[0x0000]
	{
		from = "The view from the pool is just stunning. The ocean looks so close, doesn't it?";
		to = "Die Aussicht vom Pool ist der Hammer. Das Meer scheint so nah, oder?";
	}
	[0x0000]
	{
		from = "I love how the palm trees sway in the breeze. It's like they're dancing just for us.";
		to = "Ich liebe das Schaukeln der Palmen im Wind. Es ist als würden sie nur für uns tanzen.";
	}
	[0x0000]
	{
		from = "Isn't it funny how time just seems to slow down when you're at the pool?";
		to = "Ist es nicht seltsam wie die Zeit am Pool langsamer zu vergehen scheint?";
	}

	// pool_reading
	[0x0000]
	{
		from = "Nothing beats lounging by the pool with a good book. Care to join me?";
		to = "Es gibt nichts besseres als mit einem guten Buch am Pool zu sitzen. Magst du auch?";
	}
	[0x0000]
	{
		from = "Nothing like a cold drink by the pool. Care for a taste?";
		to = "Nichts besseres als ein kühles Getränk am Pool. Magst du probieren?";
	}
	[0x0000]
	{
		from = "I could listen to the sound of the water all day. It's so calming.";
		to = "Ich könnte den ganzen Tag dem Wasser zuhören. Es ist so entspannend.";
	}

	// gratitude
	[0x0000]
	{
		from = "Thanks for stopping by! It's always nice to see a new face on the island.";
		to = "Danke fürs reinschauen! Es ist immer schön, ein neues Gesicht auf der Insel zu sehen.";
	}
	[0x0000]
	{
		from = "I'm so glad you're here. Life's simple, but full of little joys.";
		to = "Ich freue mich so dass du hier bist. Das Leben ist einfach, aber voller kleiner Freuden.";
	}

	// house_cave
	[0x0000]
	{
		from = "Between the two Giants, there's a path leading up to a viewpoint over the South Beach. It's a perfect spot for a quiet moment.";
		to = "Zwischen den beiden Riesen gibt es einen Pfad, der zu einem Aussichtspunkt über dem Südstrand führt. Es ist der perfekte Ort für einen ruhigen Moment.";
	}
	[0x0000]
	{
		from = "The nights on this island are beautiful. There are all these fireflies just floating in the air, and when you've drunk a little Cocofenny you feel like you're walking amid the stars...
Except for about one month a year, when they hatch into nasty bugs! I'm not kidding, Bug Season is dangerous! The young men go out hunting, the rest of us just stays at home until it's over.
Then, about another month of dark nights. Then, new fireflies.";
		to = "Die Nächte auf dieser Insel sind wunderschön. Da sind so viele Glühwürmer, die in der Luft herumschweben, und wenn man ein bisschen Cocofenny getrunken hat, fühlt man sich, als würde man zwischen den Sternen spazieren...
Außer etwa einen Monat im Jahr, wenn sie sich in fiese Käfer verwandeln! Ich mache keinen Spaß, die Käferzeit ist gefährlich! Die jungen Männer gehen raus zum jagen, der Rest von uns bleibt einfach im Haus bis es vorbei ist.
Dann gibt es einen Monat dunkler Nächte. Dann neue Glühwürmer.";
	}
	[0x0000]
	{
		from = "The fish stew I made last night was a hit! I'll have to give you the recipe.";
		to = "Die Fischsuppe die ich letzte Nacht gemacht habe war ein Hit! Ich muss dir unbedingt das Rezept geben.";
	}

	// south_beach
	[0x0000]
	{
		from = "Ah, the sea breeze is so refreshing today, don't you think?";
		to = "Ah, die Meeresbrise ist so erfrischend heute, findest du nicht?";
	}
	[0x0000]
	{
		from = "If you're looking to fish, the best spot is on the North Beach. The fish practically jump into your hands!";
		to = "Wenn du angeln möchtest, ist der beste Platz dafür der Nordstrand. Die Fische springen dir praktisch in die Hände!";
	}

	// barkeep
	[0x0000]
	{
		from = "Welcome to the Three Saints Bar. It's named after the three saints statues here, of course.
Fancy something to eat or drink?";
		to = "Willkommen in der Drei-Heiligen-Bar. Sie ist natürlich nach den drei Heiligenstatuen hier benannt.
Hättest du gern etwas zu essen oder zu trinken?";
	}
	[0x0000]
	{
		from = "On the menu today is grilled fish, fish coconut curry, coconut pie, some salad, and eggs.
We also still have some dried bug meat from last bug season, if you want to try.";
		to = "Auf der Karte haben wir heute gegrillten Fisch, Fisch-Kokosnuss-Curry, Kokosnuss-Kuchen, etwas Salat, und Eier.
Wir haben auch noch etwas getrocknetes Käferfleisch von der letzten Käferzeit, falls du probieren willst.";
	}
	[0x0000]
	{
		from = "For drinks we have fresh water, homemade lemonade, coffee, wine, and our specialty Cocofenny schnapps.";
		to = "Zu trinken haben wir frisches Wasser, hausgemachte Limonade, Kaffee, Wein, und unsere Spezialität Cocofenny-Schnaps.";
	}
	[0x0000]
	{
		from = "Welcome to the Three Saints Bar!";
		to = "Willkommen in der Drei-Heiligen-Bar!";
	}

	// bar1
	[0x0000]
	{
		from = "Carving driftwood is a favorite pastime of mine. Each piece tells its own story.";
		to = "Treibholz Schnitzen ist eins meiner Hobbys. Jedes Stück erzählt seine eigene Geschichte.";
	}

	// bar2
	[0x0000]
	{
		from = "I spent all morning crafting this seashell necklace. Isn't it beautiful?";
		to = "Ich hab den ganzen Vormittag lang diese Muschelkette gebastelt. Ist sie nicht schön?";
	}

	// saints
	[0x0000]
	{
		from = "The Three Saints Bar is named after the three stone heads over here. We call them our saints.";
		to = "Die Drei-Heiligen-Bar ist nach den drei Steinköpfen hier drüben benannt. Wir nennen sie unsere Heiligen.";
	}
	[0x0000]
	{
		from = "The saints were all built by our ancestors. The one on the mountain top is the newest one, it was built when I was a kid! There are sixteen saints altogether on Sunny Palms.";
		to = "Die Heiligen wurden alle von unseren Vorfahren erstellt. Der auf dem Gipfel ist der neueste, er wurde gebaut als ich ein Kind war! Insgesamt gibt es sechzehn Heilige auf Sunny Palms.";
	}
	[0x0000]
	{
		from = "There are also two huge stone heads on this island, maybe you've seen them already? They are called the Guardian and the Dreamer. They were already there when our first ancestors arrived here. Naturally, a lot of legends are told about them, but it's all just stories.";
		to = "Es gibt auch zwei riesige Steinköpfe auf dieser Insel, vielleicht hast du sie schon gesehen? Sie heißen der Wächter und der Träumer. Sie waren bereits hier, als unsere ersten Vorfahren hier ankamen. Natürlich werden viele Legenden über sie erzählt, aber das sind alles nur Geschichten.";
	}
	[0x0000]
	{
		from = "You should try the fish coconut curry here, it's delicious!";
		to = "Du solltest hier das Fisch-Kokosnuss-Curry probieren, es ist köstlich!";
	}

	// mountain
	[0x0000]
	{
		from = "Hey, found a way through that little thicket? Yeah the view is quite nice here, but you should continue upwards, you'll get to a great viewpoint above the South Beach!";
		to = "Hey, hast du einen Weg durch dieses Dickicht gefunden? Ja, die Aussicht ist ganz hübsch hier, aber du solltest noch weiter hoch, da gibt es einen tollen Aussichtspunkt über dem Südstrand!";
	}
	[0x0000]
	{
		from = "Don't worry about the cows, they're the most peaceful of all animals. You should take the upper path to reach the top, though.";
		to = "Keine Angst vor den Kühen, das sind die friedlichsten Tiere die's gibt. Zum Aussichtspunkt geht es allerdings weiter oben lang.";
	}
	[0x0000]
	{
		from = "Life on this island is so peaceful. I can't imagine living anywhere else.";
		to = "Das Leben auf dieser Insel ist so friedlich. Ich kann mir nicht vorstellen irgendwo anders zu leben.";
	}

	// guardian
	[0x0000]
	{
		from = "This giant stone head is called the Guardian, because it guards us from all the dangerous things that might come across the water. That's why this island is so safe and peaceful...";
		to = "Dieser riesige Steinkopf heißt der Wächter, weil er uns vor allen Gefahren, die übers Wasser kommen könnten, bewahrt. Deswegen ist diese Insel so sicher und friedlich...";
	}
	[0x0000]
	{
		from = "There's a second one like this, just across this hill to the south, which is called the Dreamer. It dreams of peace and happiness, and these dreams radiate across the entire island.";
		to = "Es gibt einen zweiten wie diesen, gerade über den Hügel in Richtung Süden, der der Träumer genannt wird. Er träumt von Frieden und Glück, und diese Träume strahlen über die gesamte Insel.";
	}
	[0x0000]
	{
		from = "Together, we call them the Giants.
When the first settlers, our ancestors, arrived on this island, they found these Giants already here. They built temples around them to worship them, but the Giants apparently didn't like it, because one day there was an earthquake and the temples got destroyed...";
		to = "Zusammen nennen wir sie die Riesen.
Als die ersten Siedler, unsere Vorfahren, auf dieser Insel ankamen, fanden sie diese Riesen bereits hier vor. Sie haben Temple um sie herum erbaut um sie anzubeten, aber den Riesen gefiel das wohl nicht, denn eines Tages gab es ein Erdbeben und die Tempel waren zerstört...";
	}
	[0x0000]
	{
		from = "The Guardian and the Dreamer are the reasons why our lives on Sunny Palms are so full of happiness. They don't want temples built for them, but when we pass by them on strolls around the island, we all like to stop by for a moment and give a silent prayer of thanks.";
		to = "Der Wächter und der Träumer sind der Grund für unsere glücklichen Leben hier auf Sunny Palms. Sie wollen keine Tempel haben, aber wenn wir auf Spaziergängen an ihnen vorbeikommen, halten wir alle gerne kurz an für ein kurzes stilles Dankgebet.";
	}

	// fishing
	[0x0000]
	{
		from = "Mornin'! Nice day for fishin', ain't it!";
		to = "Morgen! Toller Tag zum Angeln, oder!";
	}
	[0x0000]
	{
		from = "I was up early to catch the fish today. The waters have been bountiful this season.";
		to = "Ich bin heute früh aufgestanden um Fisch zu fangen. Das Meer war voll von ihnen dieses Jahr.";
	}

	// crystals
	[0x0000]
	{
		from = "Aren't these crystals just super awesome! I could spend hours just looking at them! Sometimes I do.";
		to = "Sind diese Kristalle nicht der absolute Hammer! Ich könnte sie stundenlang anstarren! Manchmal mache ich das auch.";
	}
}
